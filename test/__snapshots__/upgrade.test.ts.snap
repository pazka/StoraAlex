// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`node:sqlite: migrations, schema, transactions > runs all migrations on a fresh database and pins the resulting schema 1`] = `
{
  "columns": {
    "code": [
      "id INTEGER PK",
      "code_value TEXT NOT NULL",
      "entity_type TEXT NOT NULL",
      "entity_id INTEGER",
      "status TEXT NOT NULL",
      "created_at TEXT NOT NULL",
    ],
    "code_seq": [
      "entity_type TEXT PK",
      "next_value INTEGER NOT NULL",
    ],
    "item": [
      "id INTEGER PK",
      "code_display TEXT NOT NULL",
      "name TEXT NOT NULL",
      "photo_id INTEGER",
      "location_place_id INTEGER",
      "notes TEXT",
      "created_at TEXT NOT NULL",
      "updated_at TEXT NOT NULL",
      "price REAL",
      "archived_at TEXT",
    ],
    "item_tag": [
      "item_id INTEGER NOT NULL PK",
      "tag_id INTEGER NOT NULL PK",
    ],
    "movement": [
      "id INTEGER PK",
      "at TEXT NOT NULL",
      "user_id INTEGER",
      "entity_type TEXT NOT NULL",
      "entity_id INTEGER NOT NULL",
      "action TEXT NOT NULL",
      "from_place_id INTEGER",
      "to_place_id INTEGER",
      "method TEXT NOT NULL",
      "note TEXT",
    ],
    "photo": [
      "id INTEGER PK",
      "path TEXT NOT NULL",
      "width INTEGER",
      "height INTEGER",
      "bytes INTEGER",
      "created_at TEXT NOT NULL",
    ],
    "place": [
      "id INTEGER PK",
      "code_display TEXT NOT NULL",
      "name TEXT NOT NULL",
      "photo_id INTEGER",
      "info TEXT",
      "parent_place_id INTEGER",
      "created_at TEXT NOT NULL",
      "updated_at TEXT NOT NULL",
      "archived_at TEXT",
    ],
    "place_tag": [
      "place_id INTEGER NOT NULL PK",
      "tag_id INTEGER NOT NULL PK",
    ],
    "schema_migrations": [
      "name TEXT PK",
      "applied_at TEXT NOT NULL",
    ],
    "session": [
      "id TEXT PK",
      "user_id INTEGER NOT NULL",
      "created_at TEXT NOT NULL",
      "expires_at TEXT NOT NULL",
      "user_agent TEXT",
    ],
    "tag": [
      "id INTEGER PK",
      "name TEXT NOT NULL",
      "color TEXT",
      "kind TEXT NOT NULL",
    ],
    "user": [
      "id INTEGER PK",
      "username TEXT NOT NULL",
      "password_hash TEXT NOT NULL",
      "created_at TEXT NOT NULL",
      "last_login_at TEXT",
    ],
  },
  "objects": [
    "index idx_code_entity on code",
    "index idx_item_location on item",
    "index idx_movement_at on movement",
    "index idx_movement_entity on movement",
    "index idx_place_parent on place",
    "index idx_session_expires on session",
    "index idx_session_user on session",
    "table code on code",
    "table code_seq on code_seq",
    "table item on item",
    "table item_tag on item_tag",
    "table movement on movement",
    "table photo on photo",
    "table place on place",
    "table place_tag on place_tag",
    "table schema_migrations on schema_migrations",
    "table session on session",
    "table tag on tag",
    "table user on user",
    "trigger movement_no_delete on movement",
    "trigger movement_no_update on movement",
  ],
}
`;
