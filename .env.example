# StorAlex environment. On the hosh.it box: copy to storalex.env (chmod 600, see DEPLOY.md); the
# defaults below are the box values, then the OWNER fills the secrets (never an agent).
# `hosh-deploy register` checks that the names on the `# required:` line are non-empty.
# Local use: copy to .env (docker-compose.yml / npm run dev). NEVER commit the real file.
# The file is also read by compose for interpolation: single-quote any value containing `$`.
# required: APP_PEPPER SESSION_KEY

# --- deployment (hosh-deploy; ignored by the app) ---
# The only line hosh-deploy changes (one release tag per deploy).
APP_IMAGE='ghcr.io/pazka/storalex:v1.2.0'
APP_BIND='127.0.0.1:9138'

# --- Server ---
NODE_ENV=production
# Behind Traefik, X-Forwarded-For is trustworthy only from loopback / the docker gateway.
# Also accepts a hop count (1 = a single reverse proxy; the legacy box uses 1). Never "true":
# it trusts a client-spoofable X-Forwarded-For and defeats per-IP login rate limiting.
TRUST_PROXY='127.0.0.0/8,::1/128,172.16.0.0/12'
# PORT and DATA_DIR are fixed by docker-compose.example.yml (8000, /data) and
# docker-compose.yml (8080, /data); the image defaults are 8080 and /data.

# --- Secrets (owner; generate with: openssl rand -hex 32) ---
# Server-side pepper mixed into password hashing. Changing it locks every user out: on a move,
# copy the existing value, never regenerate it.
APP_PEPPER=
# Key used to sign session cookies (changing it only logs everyone out).
SESSION_KEY=

# --- First user (optional, local only) ---
# The first run prompts you to create the first account in the app. `npm run seed` can
# pre-create one headlessly from these instead; leave blank otherwise.
SEED_ADMIN_USER=
SEED_ADMIN_PASSWORD=

# --- Storage (optional overrides; defaults derive from DATA_DIR) ---
# DB_PATH=/data/storalex.db
# MEDIA_DIR=/data/media

# --- Optional tuning ---
# HOST=0.0.0.0
# SESSION_TTL_DAYS=30
# MAX_UPLOAD_BYTES=15728640   # 15 MiB cap per uploaded photo

# --- Google Sheet mirror (optional; leave SHEET_ID empty to disable) ---
# Share the target Sheet with the service-account email as Editor.
SHEET_ID=
# Service-account key, one of:
#  - GOOGLE_SERVICE_ACCOUNT_JSON_B64: the JSON key file, base64 on one line
#    (box: `base64 -w0 google-sa.json`). Works without any file mount (hosh-deploy).
#  - GOOGLE_SERVICE_ACCOUNT_JSON: a path inside the container (legacy box:
#    /run/secrets/google-sa.json, bind-mounted) or the inline JSON. Wins if both are set.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Push DB -> Sheet at most this often (ms), plus a periodic reconcile.
SHEET_SYNC_DEBOUNCE_MS=10000
